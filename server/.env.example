# ---- Server ----------------------------------------------------------------
# Port the API listens on.
PORT=4000

# IMPORTANT: change this in any real deployment. The server falls back to an
# insecure development secret if it is unset.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file and upload directory (relative to server/).
DB_FILE=data/study.db
UPLOAD_DIR=data/uploads

# ---- AI providers ----------------------------------------------------------
# Embeddings: 'hashing' (offline, default) or 'transformers' (needs
# `npm i @xenova/transformers`).
EMBEDDING_PROVIDER=hashing
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# LLM: 'extractive' (offline, default) or 'openai' (any OpenAI-compatible API).
LLM_PROVIDER=extractive
# Works with OpenAI, Groq, Together, vLLM, or Ollama's OpenAI-compatible endpoint.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
